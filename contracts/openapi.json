    "/v1/me/memberships": {
      "get": {
        "operationId": "me_memberships",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Membership"
                      }
                    },
                    "lastMembershipId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "items",
                    "lastMembershipId"
                  ],
                  "additionalProperties": false,
                  "example": {
                    "items": [
                      {
                        "id": "019a8f3e-8a10-7e55-8c1d-2b3c4d5e6f70",
                        "role": "tenant_owner",
                        "label": "Giáo viên · Cô Lan",
                        "tenantId": "019a8f3e-8a10-7e55-8c1d-0a1b2c3d4e5f",
                        "studentId": null
                      },
                      {
                        "id": "019a8f3e-9b21-7f66-9d2e-3c4d5e6f7a81",
                        "role": "parent",
                        "label": "Phụ huynh",
                        "tenantId": null,
                        "studentId": null
                      },
                      {
                        "id": "019a8f3e-ac32-7a77-8e3f-4d5e6f7a8b92",
                        "role": "student",
                        "label": "Học sinh",
                        "tenantId": null,
                        "studentId": null
                      }
                    ],
                    "lastMembershipId": "019a8f3e-8a10-7e55-8c1d-2b3c4d5e6f70"
                  }
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED, TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Danh sách vai trò của user kèm nhãn hiển thị (US-0.10, US-0.11)",
        "tags": [
          "me"
        ]
      }
