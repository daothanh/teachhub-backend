{
  "name": "teachhub-backend",
  "version": "0.0.1",
  "description": "TeachHub backend — NestJS modular monolith (api + worker)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build api && nest build worker",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start:api": "nest start api --watch --env-file .env",
    "start:worker": "nest start worker --watch --env-file .env",
    "start:prod:api": "node dist/apps/api/main.js",
    "start:prod:worker": "node dist/apps/worker/main.js",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "typecheck": "tsc -p tsconfig.spec.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "openapi:gen": "UPDATE_OPENAPI=1 vitest run apps/api/src/openapi.spec.ts",
    "seed:dev": "node --env-file=.env scripts/seed-dev.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "seed:link-guardians": "node --env-file=.env scripts/seed-link-guardians.mjs",
    "mock": "docker compose --profile mock up mock"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "3.1168.0",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@sentry/nestjs": "^11.16.0",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.1",
    "ioredis": "^6.0.0",
    "jose": "6.2.13",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.4.0",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@testcontainers/minio": "12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0"
}
