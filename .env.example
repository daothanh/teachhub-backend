# Cổng host cho docker compose (tránh đụng Postgres/Redis cài sẵn trên máy)
PG_PORT=5433
REDIS_PORT=6380
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
# Phải đặt tường minh: chỉ `local`/`test` được dùng khóa bí mật tạm; thiếu NODE_ENV thì coi như không phải local.
NODE_ENV=local
PORT=3000
# Số proxy tin cậy phía trước api để lấy IP client (X-Forwarded-For): 1 khi chỉ Caddy, 2 khi Cloudflare + Caddy. Đặt sai làm sai bộ đếm theo IP.
TRUST_PROXY_HOPS=1
LOG_LEVEL=debug
DATABASE_URL=postgres://teachhub_app:teachhub_app@localhost:5433/teachhub
WORKER_DATABASE_URL=postgres://teachhub_worker:teachhub_worker@localhost:5433/teachhub
MIGRATION_DATABASE_URL=postgres://teachhub_owner:teachhub_owner@localhost:5433/teachhub
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Kho S3 (Mục 2.8) — MinIO trong docker compose
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET_PRIVATE=teachhub-local-private
# Access token ES256 (S1-BE-03). Local/test bỏ trống → khóa tạm sinh lúc khởi động.
# Staging/production bắt buộc. Sinh khóa: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_KID=2026-11
# Khi xoay vòng: khóa công khai cũ (openssl pkey -pubout) + kid cũ, giữ ≥ 15 phút.
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KID=
# Email (S1-BE-04): Mailpit trong docker compose — xem thư ở http://localhost:8025.
# Dùng 127.0.0.1 (localhost có thể ra IPv6). Staging/production: SMTP của SES (S0-PO-08).
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="DayHoc <no-reply@dayhoc.app>"
# SSO Google (S1-BE-06): các client ID là `aud` hợp lệ của id_token, ngăn cách bởi dấu phẩy, dạng <số>-<chuỗi>.apps.googleusercontent.com.
# Local/test để trống = từ chối id_token; mọi môi trường khác bắt buộc. Mỗi môi trường dùng project Google riêng (không bí mật):
#   development (dayhoc-dev): Web 305225338991-7vf98anmjogm9jksgd9kdije4ah8ncgk, iOS 305225338991-eg6h9lb26na0br8qph3gaff5041dga2f,
#     Android debug 305225338991-r640djv4j04rhv3uqq8g4m56bs3n901a, Android upload 305225338991-5m421cgrtvgf1flv3dhgu8i50uotj9n9
#   staging (dayhoc-stg): Web 753323722874-khh3u3aobf813cib4l2m6bvotebld0q7, iOS 753323722874-o79dktgt6nnak8npj90nm114p1jv6aca,
#     Android debug 753323722874-at7jre1ehfam9pt140oar0d3k3dqbnd2, Android upload 753323722874-hmhkvu7f1bkgm00mgjkv40k52hrs6pig
#   production (dayhoc-4c6db): chỉ Web 432762025168-e2lo4mengjqb64e8bc2sdoat1vbqpdl8, iOS 432762025168-cp0i0crpa16la5fuudd95sbkfasc84tc,
#     Android upload 432762025168-jfmmmpogljjoilurl0t6i7m60d172e19. KHÔNG đưa Android debug vào production (app từ chối khởi động).
# (mọi ID ở trên cộng hậu tố .apps.googleusercontent.com). Android lấy idToken với serverClientId = Web client ID; iOS có `aud` = iOS client ID.
GOOGLE_CLIENT_IDS=
# FCM (S3-BE-06): service account Firebase, JSON một dòng. Trống = worker tắt gửi push và log cảnh báo.
# FCM_SERVICE_ACCOUNT_JSON=
# SSO Apple (S2-BE-01): bundle ID iOS = `aud` của identityToken. Trống = từ chối token Apple.
APPLE_BUNDLE_ID=vn.dayhoc.app
# Lời mời phụ huynh, đồng ý xử lý dữ liệu (S4-BE-03..05). Local/test bỏ trống → khóa tạm cố định; staging/production bắt buộc (>= 16 ký tự, ngẫu nhiên, mỗi khóa một giá trị).
# CURRENT_TERMS_VERSION=2026-12-01
# INVITE_BASE_URL=https://dayhoc.app/i
# CONSENT_IP_HMAC_KEY=
# INVITE_CODE_HMAC_KEY=
# IDEMPOTENCY_ENC_KEY=
