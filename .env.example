# Cổng host cho docker compose (tránh đụng Postgres/Redis cài sẵn trên máy)
PG_PORT=5433
REDIS_PORT=6380
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
NODE_ENV=local
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://teachhub_app:teachhub_app@localhost:5433/teachhub
WORKER_DATABASE_URL=postgres://teachhub_worker:teachhub_worker@localhost:5433/teachhub
MIGRATION_DATABASE_URL=postgres://teachhub_owner:teachhub_owner@localhost:5433/teachhub
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Kho S3 (Mục 2.8) — MinIO trong docker compose
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET_PRIVATE=teachhub-local-private
# Access token ES256 (S1-BE-03). Local/test bỏ trống → khóa tạm sinh lúc khởi động.
# Staging/production bắt buộc. Sinh khóa: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_KID=2026-11
# Khi xoay vòng: khóa công khai cũ (openssl pkey -pubout) + kid cũ, giữ ≥ 15 phút.
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KID=
