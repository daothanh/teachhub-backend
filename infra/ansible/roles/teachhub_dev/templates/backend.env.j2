NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://teachhub_app:{{ db_passwords.app }}@postgres:5432/teachhub
WORKER_DATABASE_URL=postgres://teachhub_worker:{{ db_passwords.worker }}@postgres:5432/teachhub
MIGRATION_DATABASE_URL=postgres://teachhub_owner:{{ db_passwords.owner }}@postgres:5432/teachhub
REDIS_URL=redis://redis:6379
CORS_ORIGINS=https://{{ hosts.app }},https://{{ hosts.admin }}
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=teachhub
S3_SECRET_ACCESS_KEY={{ minio_password }}
S3_BUCKET_PRIVATE=teachhub-dev-private
SMTP_URL=smtp://mailpit:1025
# Cloudflare + Caddy.
TRUST_PROXY_HOPS=2
# PEM một dòng, app đổi `\n` thành xuống dòng.
JWT_PRIVATE_KEY={{ jwt_private_key | trim | replace('\n', '\\n') }}
JWT_KID=dev-1
# Client ID Google của project dayhoc-dev (không bí mật): Web, iOS, Android debug, Android upload.
GOOGLE_CLIENT_IDS=305225338991-7vf98anmjogm9jksgd9kdije4ah8ncgk.apps.googleusercontent.com,305225338991-eg6h9lb26na0br8qph3gaff5041dga2f.apps.googleusercontent.com,305225338991-r640djv4j04rhv3uqq8g4m56bs3n901a.apps.googleusercontent.com,305225338991-5m421cgrtvgf1flv3dhgu8i50uotj9n9.apps.googleusercontent.com
# Khóa ứng dụng (tofu: random_password.app_key), ba khóa đầu phải khác nhau.
CONSENT_IP_HMAC_KEY={{ app_keys.consent_ip_hmac }}
INVITE_CODE_HMAC_KEY={{ app_keys.invite_code_hmac }}
IDEMPOTENCY_ENC_KEY={{ app_keys.idempotency_enc }}
ADMIN_API_SECRET={{ app_keys.admin_api }}
