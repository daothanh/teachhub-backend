{
	# Chứng chỉ Origin CA nạp tay, không cần ACME; cổng 80 bị Hetzner Firewall chặn.
	auto_https off
	servers {
		# Tin X-Forwarded-For do Cloudflare ghi để api thấy IP thật của client (TRUST_PROXY_HOPS=2).
		trusted_proxies static {{ cloudflare_cidrs | join(' ') }}
	}
}

(origin_tls) {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
}

https://{{ hosts.api }} {
	import origin_tls
	reverse_proxy api:3000
}

# Chỉ chuyển tiếp form POST của Apple khi lưu lượng host app đi qua origin này.
https://{{ hosts.app }} {
	import origin_tls
	@apple_android_callback {
		method POST
		path /auth/apple/callback
	}
	handle @apple_android_callback {
		rewrite * /v1/auth/sso/apple/android/callback
		reverse_proxy api:3000
	}
	handle {
		respond "Chưa triển khai" 503
	}
}

https://{{ hosts.admin }} {
	import origin_tls
	respond "Chưa triển khai" 503
}
