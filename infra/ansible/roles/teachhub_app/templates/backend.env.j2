NODE_ENV={{ node_env }}
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://teachhub_app:{{ db_passwords.app }}@postgres:5432/teachhub
WORKER_DATABASE_URL=postgres://teachhub_worker:{{ db_passwords.worker }}@postgres:5432/teachhub
MIGRATION_DATABASE_URL=postgres://teachhub_owner:{{ db_passwords.owner }}@postgres:5432/teachhub
REDIS_URL=redis://redis:6379
CORS_ORIGINS=https://{{ hosts.app }},https://{{ hosts.admin }}
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=teachhub
S3_SECRET_ACCESS_KEY={{ minio_password }}
S3_BUCKET_PRIVATE=teachhub-{{ env_name }}-private
# dev: Mailpit trong compose; staging: SES SMTP (smtp_url do Owner cấp, mật khẩu đã URL-encode). Nháy đơn để compose không nội suy `$`.
SMTP_URL='{{ smtp_url }}'
# Cloudflare + Caddy.
TRUST_PROXY_HOPS=2
# PEM một dòng, app đổi `\n` thành xuống dòng.
JWT_PRIVATE_KEY={{ jwt_private_key | trim | replace('\n', '\\n') }}
JWT_KID={{ env_name }}-1
# Client ID Google của project theo môi trường (không bí mật): Web, iOS, Android debug, Android upload. Truyền qua `google_client_ids`.
GOOGLE_CLIENT_IDS={{ google_client_ids | join(',') }}
{% if apple_bundle_id | length > 0 %}
APPLE_BUNDLE_ID={{ apple_bundle_id | join(',') }}
{% endif %}
{% if fcm_service_account_json is defined %}
# Service account Firebase (JSON một dòng) cho worker gửi FCM; thiếu = tắt push.
FCM_SERVICE_ACCOUNT_JSON='{{ (fcm_service_account_json if fcm_service_account_json is mapping else fcm_service_account_json | from_json) | to_json }}'
{% endif %}
# Khóa ứng dụng (tofu: random_password.app_key), ba khóa đầu phải khác nhau.
CONSENT_IP_HMAC_KEY={{ app_keys.consent_ip_hmac }}
INVITE_CODE_HMAC_KEY={{ app_keys.invite_code_hmac }}
IDEMPOTENCY_ENC_KEY={{ app_keys.idempotency_enc }}
ADMIN_API_SECRET={{ app_keys.admin_api }}
